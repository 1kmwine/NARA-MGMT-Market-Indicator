# 이 파일을 복사해서 .env로 저장하고, 실제 발급받은 인증키를 채워 넣으세요.
# (터미널에서: copy .env.example .env)

# 한국은행 ECOS 인증키 — https://ecos.bok.or.kr 에서 발급
ECOS_API_KEY=여기에_ECOS_인증키_붙여넣기

# 통계청 KOSIS 인증키 — https://kosis.kr/openapi 에서 발급
KOSIS_API_KEY=여기에_KOSIS_인증키_붙여넣기

# 테스트 서버 MariaDB (192.168.47.105) — 선행지표 전용 leading_indicator 스키마
# 실제 비밀번호는 CREDENTIALS.strategy.local.md 참고. 이 파일(.env)은 절대 커밋 금지.
DB_HOST=192.168.47.105
DB_PORT=3306
DB_NAME=leading_indicator
DB_USER=여기에_DB_계정_붙여넣기
DB_PASSWORD=여기에_DB_비밀번호_붙여넣기
